rules_version = '2';

// Модуль живых лекций: коллекции lectures/{id}, lectures/{id}/sections,
// lectures/{id}/attendees. Доступ — только авторизованным (включая
// анонимных) пользователям. Для продакшена замени на правила по владельцу
// (teacherId == request.auth.uid) и «join»-правила для студентов.
service cloud.firestore {
  match /databases/{database}/documents {
    match /lectures/{lectureId} {
      allow read, write: if request.auth != null;

      match /sections/{sectionId} {
        allow read, write: if request.auth != null;
      }

      match /attendees/{studentId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}