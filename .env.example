# Скопируй в .env.local и заполни значениями.
# GROQ_API_KEY — ключ https://console.groq.com/keys (для серверного AI-роута).
GROQ_API_KEY=gsk_...

# Ссылка, на которую ведёт QR-код в HERO лендинга (для презентаций).
# На Vercel можно указать свой домен, например https://unios-ai.vercel.app.
NEXT_PUBLIC_QR_URL=https://unios-ai.web.app