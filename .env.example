# Скопируй в .env.local и заполни значениями.
# GROQ_API_KEY — ключ https://console.groq.com/keys (для серверного AI-роута).
GROQ_API_KEY=gsk_...

# Ссылка, на которую ведёт QR-код в HERO лендинга (для презентаций).
# На Vercel можно указать свой домен, например https://unios-ai.vercel.app.
NEXT_PUBLIC_QR_URL=https://unios-ai.web.app

# Конфиг Firebase Web App (JSON-строка) для модуля живых лекций: Firebase
# Auth (анонимный вход) + Cloud Firestore. Взять в Firebase Console →
# Project settings → Your apps → Web app → SDK setup → `firebaseConfig = {...}`.
# Vercel: добавь ту же переменную в Environment Variables проекта (Build-time).
# Пример (замени на свои значения):
# NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"AIza...","authDomain":"unios-ai.firebaseapp.com","projectId":"unios-ai","storageBucket":"unios-ai.appspot.com","messagingSenderId":"1234567890","appId":"1:1234567890:web:abcdef"}
# Без этой переменной приложение работает в demo-режиме: live-лекции
# синхронизируются локально между вкладками одного браузера (Firestore не используется).